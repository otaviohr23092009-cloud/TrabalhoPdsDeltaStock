@page "/ProdutosAdicionar"
@rendermode InteractiveServer
@inject ProdutoDAO ProdutoDao
@inject CategoriaDAO CategoriaDao
@inject NavigationManager NavigationManager

<PageTitle>Adicionar produto</PageTitle>

<div class="produto-cadastro-page">
    <div class="produto-cadastro-header">
        <div>
            <h1>Adicionar produto</h1>
            <p>Os dados serão salvos diretamente no banco local.</p>
        </div>
        <a class="categoria-link" href="/Categoria">Gerenciar categorias</a>
    </div>

    @if (MensagemErro is not null)
    {
        <div class="produto-feedback produto-error">@MensagemErro</div>
    }

    <EditForm Model="ProdutoForm" OnValidSubmit="SalvarProduto" FormName="produto-form" class="produto-form produto-cadastro-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label>
            Código
            <input @bind="ProdutoForm.Codigo" placeholder="Ex.: TEC-001" />
            <ValidationMessage For="@(() => ProdutoForm.Codigo)" />
        </label>
        <label>
            Nome
            <input @bind="ProdutoForm.Nome" placeholder="Nome do produto" />
            <ValidationMessage For="@(() => ProdutoForm.Nome)" />
        </label>
        <label class="produto-form-full">
            Descrição
            <textarea @bind="ProdutoForm.Descricao" placeholder="Descreva o produto"></textarea>
        </label>
        <label>
            Categoria
            <select @bind="ProdutoForm.IdCategoria">
                <option value="0">Selecione uma categoria</option>
                @foreach (var categoria in Categorias)
                {
                    <option value="@categoria.Id">@categoria.Nome</option>
                }
            </select>
            <ValidationMessage For="@(() => ProdutoForm.IdCategoria)" />
        </label>
        <label>
            Status
            <select @bind="ProdutoForm.Status">
                <option value="Ativo">Ativo</option>
                <option value="Inativo">Inativo</option>
            </select>
        </label>
        <label>
            Quantidade inicial
            <input type="number" min="0" @bind="ProdutoForm.Quantidade" />
            <ValidationMessage For="@(() => ProdutoForm.Quantidade)" />
        </label>
        <label>
            Custo (R$)
            <input type="number" min="0" step="0.01" @bind="ProdutoForm.Custo" />
            <ValidationMessage For="@(() => ProdutoForm.Custo)" />
        </label>
        <label>
            Preço de venda (R$)
            <input type="number" min="0" step="0.01" @bind="ProdutoForm.ValorVenda" />
            <ValidationMessage For="@(() => ProdutoForm.ValorVenda)" />
        </label>

        <div class="produto-form-actions produto-form-full">
            <a href="/ProdutosVisualizar" class="produto-cancelar">Cancelar</a>
            <button type="submit">Salvar produto</button>
        </div>
    </EditForm>
</div>

@code {
    private Produto ProdutoForm { get; set; } = new();
    private List<DeltaStock.Models.Categoria> Categorias { get; set; } = [];
    private string? MensagemErro { get; set; }

    protected override void OnInitialized()
    {
        try
        {
            Categorias = CategoriaDao.Listar();
        }
        catch (Exception ex)
        {
            MensagemErro = $"Não foi possível carregar as categorias. Confira a conexão com o banco. ({ex.Message})";
        }
    }

    private void SalvarProduto()
    {
        try
        {
            ProdutoDao.Adicionar(ProdutoForm);
            NavigationManager.NavigateTo("/ProdutosVisualizar");
        }
        catch (Exception ex)
        {
            MensagemErro = $"Não foi possível salvar o produto. ({ex.Message})";
        }
    }
}
