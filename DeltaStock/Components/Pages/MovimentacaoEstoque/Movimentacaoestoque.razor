@page "/MovimentacaoEstoque"
@page "/Movimentacao"
@rendermode InteractiveServer
@using DeltaStock.DAO
@using DeltaStock.Models
@inject MovimentacaoDAO MovimentacaoDao

<PageTitle>Movimentações</PageTitle>

<div class="movimentacao-page">
    <div class="movimentacao-header">
        <div>
            <h1>Movimentações de Estoque</h1>
            <p>Histórico de entradas e saídas do estoque.</p>
        </div>
        <span class="movimentacao-total">@Movimentacoes.Count movimentaç@(Movimentacoes.Count == 1 ? "ão" : "ões")</span>
    </div>

    @if (Carregando)
    {
        <div class="movimentacao-feedback">Carregando movimentações...</div>
    }
    else if (MensagemErro is not null)
    {
        <div class="movimentacao-feedback movimentacao-error">
            <strong>Não foi possível carregar as movimentações.</strong>
            <span>@MensagemErro</span>
        </div>
    }
    else if (Movimentacoes.Count == 0)
    {
        <div class="movimentacao-feedback">Nenhuma movimentação registrada ainda.</div>
    }
    else
    {
        <div class="movimentacao-table-wrapper">
            <table class="movimentacao-table">
                <thead>
                    <tr>
                        <th>#ID</th>
                        <th>Data/Hora</th>
                        <th>Tipo</th>
                        <th>Qtd.</th>
                        <th>Saldo Ant.</th>
                        <th>Saldo Fin.</th>
                        <th>Origem</th>
                        <th>Documento</th>
                        <th>Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mov in Movimentacoes)
                    {
                        <tr>
                            <td>@mov.Id</td>
                            <td>@mov.Data.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge-tipo @ObterClasseBadge(mov.Tipo)">
                                    @mov.Tipo
                                </span>
                            </td>
                            <td><strong>@mov.Quantidade</strong></td>
                            <td>@mov.SaldoAnterior</td>
                            <td><strong>@mov.SaldoFinal</strong></td>
                            <td>@mov.Origem</td>
                            <td>@(string.IsNullOrWhiteSpace(mov.Id_documento) ? "-" : mov.Id_documento)</td>
                            <td>@(string.IsNullOrWhiteSpace(mov.Motivo) ? "-" : mov.Motivo)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Movimentacao> Movimentacoes { get; set; } = [];
    private bool Carregando { get; set; } = true;
    private string? MensagemErro { get; set; }

    protected override Task OnInitializedAsync()
    {
        try
        {
            Movimentacoes = MovimentacaoDao.Listar();
        }
        catch (Exception ex)
        {
            MensagemErro = $"Confira se o MySQL está em execução e se os dados de conexão em appsettings.json estão corretos. ({ex.Message})";
        }
        finally
        {
            Carregando = false;
        }

        return Task.CompletedTask;
    }

    private string ObterClasseBadge(string tipo)
    {
        return tipo?.ToUpper() switch
        {
            "ENTRADA" => "badge-entrada",
            "SAIDA" => "badge-saida",
            "AJUSTE+" => "badge-ajuste-pos",
            "AJUSTE-" => "badge-ajuste-neg",
            "PERDA" => "badge-perda",
            _ => "badge-default"
        };
    }
}